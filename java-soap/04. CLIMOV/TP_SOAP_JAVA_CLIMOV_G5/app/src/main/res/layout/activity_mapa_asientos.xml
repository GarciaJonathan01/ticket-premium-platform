<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="16dp"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverMapa"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Volver"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏟️ Mapa de Selección de Asientos"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPartidoInfoMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Content (Scrollable Stadium Layout) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <!-- Leyenda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:padding="8dp">

                <!-- Disponible -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#10b981"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disponible"
                        android:textColor="#94a3b8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Seleccionado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#f59e0b"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionado"
                        android:textColor="#94a3b8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Ocupado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#ef4444"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ocupado"
                        android:textColor="#94a3b8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbMapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- STADIUM CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutEstadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_horizontal">

                <!-- 1. GENERAL NORTE -->
                <TextView
                    android:id="@+id/tvNorteTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Norte"
                    android:textColor="#cbd5e1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <GridLayout
                    android:id="@+id/gridGeneralNorte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="6"
                    android:alignmentMode="alignBounds"
                    android:layout_marginBottom="12dp" />

                <!-- 2. MEDIO (PALCO + CANCHA + TRIBUNA) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Palco (Left) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Palco (VIP)"
                            android:textColor="#cbd5e1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />
                        <GridLayout
                            android:id="@+id/gridPalco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />
                    </LinearLayout>

                    <!-- Cancha Central (Middle) -->
                    <ec.edu.monster.vista.CanchaView
                        android:id="@+id/canchaCentral"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginHorizontal="6dp" />

                    <!-- Tribuna (Right) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tribuna"
                            android:textColor="#cbd5e1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />
                        <GridLayout
                            android:id="@+id/gridTribuna"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. GENERAL SUR -->
                <TextView
                    android:id="@+id/tvSurTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Sur"
                    android:textColor="#cbd5e1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <GridLayout
                    android:id="@+id/gridGeneralSur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="6"
                    android:alignmentMode="alignBounds" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Checkout Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="14dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tvSeleccionResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asientos seleccionados: Ninguno"
            android:textColor="#cbd5e1"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTotalMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Selección: $0.00 (IVA incl.)"
            android:textColor="#10b981"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarMapa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Continuar con la Compra"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#10b981" />
    </LinearLayout>

</LinearLayout>
