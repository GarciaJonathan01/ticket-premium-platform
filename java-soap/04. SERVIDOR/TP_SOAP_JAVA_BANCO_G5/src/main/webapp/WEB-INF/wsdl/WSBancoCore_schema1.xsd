<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" targetNamespace="http://ws.monster.edu.ec/" xmlns:tns="http://ws.monster.edu.ec/" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="verificarYCrearCredito" type="tns:verificarYCrearCredito"/>

  <xs:element name="verificarYCrearCreditoResponse" type="tns:verificarYCrearCreditoResponse"/>

  <xs:complexType name="verificarYCrearCredito">
    <xs:sequence>
      <xs:element name="cedula" type="xs:string" minOccurs="0"/>
      <xs:element name="montoCompra" type="xs:double"/>
      <xs:element name="plazoMeses" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="verificarYCrearCreditoResponse">
    <xs:sequence>
      <xs:element name="return" type="tns:respuestaCredito" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="respuestaCredito">
    <xs:sequence>
      <xs:element name="aprobado" type="xs:boolean"/>
      <xs:element name="idCredito" type="xs:int"/>
      <xs:element name="mensaje" type="xs:string" minOccurs="0"/>
      <xs:element name="montoMaximo" type="xs:double"/>
      <xs:element name="tablaAmortizacion" type="tns:cuotaAmortizacion" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="cuotaAmortizacion">
    <xs:sequence>
      <xs:element name="capitalPagado" type="xs:double"/>
      <xs:element name="interesPagado" type="xs:double"/>
      <xs:element name="numCuota" type="xs:int"/>
      <xs:element name="saldo" type="xs:double"/>
      <xs:element name="valorCuota" type="xs:double"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>

