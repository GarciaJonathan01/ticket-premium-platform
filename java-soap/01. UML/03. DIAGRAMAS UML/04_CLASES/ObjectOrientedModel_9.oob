<o:Operation Id="o271">
<a:ObjectID>1BF9355F-691B-4409-95CC-7A333DAFEC93</a:ObjectID>
<a:Name>comprarBoletos</a:Name>
<a:Code>comprarBoletos</a:Code>
<a:CreationDate>1779227247</a:CreationDate>
<a:Creator>nando</a:Creator>
<a:ModificationDate>1779227247</a:ModificationDate>
<a:Modifier>nando</a:Modifier>
<a:Comment> ==========================================
 REGISTRAR COMPRA MÚLTIPLE (Factura + Detalles)
 ==========================================</a:Comment>
<a:ReturnType>Factura</a:ReturnType>
<a:TemplateBody>{
    if (peticiones == null || peticiones.isEmpty()) return null;
    
    double subtotal = 0;
    for (PeticionCompra p : peticiones) {
        subtotal += p.getCantidad() * p.getPrecioUnitario();
    }
    double iva = subtotal * 0.15; // IVA Ecuador 15%
    double total = subtotal + iva;

    Factura factura = new Factura();
    factura.setCodigoPartido(codigoPartido);
    factura.setNombreCliente(nombreCliente);
    factura.setSubtotal(subtotal);
    factura.setIva(iva);
    factura.setTotal(total);

    String sqlFactura = &quot;INSERT INTO FACTURA (CODIGO_PARTIDO, NOMBRE_CLIENTE, FECHA, SUBTOTAL, IVA, TOTAL) &quot;
                      + &quot;VALUES (?, ?, NOW(), ?, ?, ?)&quot;;
    String sqlDetalle = &quot;INSERT INTO DETALLE_FACTURA (ID_FACTURA, CODIGO_PARTIDO, CODIGO_LOCALIDAD, CANTIDAD, PRECIO_UNITARIO, SUBTOTAL) &quot;
                      + &quot;VALUES (?, ?, ?, ?, ?, ?)&quot;;
    String sqlRestarDisp = &quot;UPDATE LOCALIDAD_PARTIDO SET DISPONIBILIDAD = DISPONIBILIDAD - ? WHERE ID = ? AND DISPONIBILIDAD &gt;= ?&quot;;

    try (Connection conn = getConnection()) {
        conn.setAutoCommit(false);
        try {
            // Insertar factura
            try (PreparedStatement ps = conn.prepareStatement(sqlFactura, Statement.RETURN_GENERATED_KEYS)) {
                ps.setInt(1, codigoPartido);
                ps.setString(2, nombreCliente);
                ps.setDouble(3, subtotal);
                ps.setDouble(4, iva);
                ps.setDouble(5, total);
                ps.executeUpdate();

                try (ResultSet rs = ps.getGeneratedKeys()) {
                    if (rs.next()) {
                        factura.setId(rs.getInt(1));
                    }
                }
            }

            // Insertar detalles y restar disponibilidad
            try (PreparedStatement psDetalle = conn.prepareStatement(sqlDetalle);
                 PreparedStatement psRestar = conn.prepareStatement(sqlRestarDisp)) {
                
                for (PeticionCompra p : peticiones) {
                    // Restar disponibilidad
                    psRestar.setInt(1, p.getCantidad());
                    psRestar.setInt(2, p.getIdLocalidad());
                    psRestar.setInt(3, p.getCantidad());
                    int updated = psRestar.executeUpdate();
                    if (updated == 0) {
                        throw new SQLException(&quot;Disponibilidad insuficiente para la localidad: &quot; + p.getCodigoLocalidad());
                    }
                    
                    // Insertar detalle
                    psDetalle.setInt(1, factura.getId());
                    psDetalle.setInt(2, codigoPartido);
                    psDetalle.setString(3, p.getCodigoLocalidad());
                    psDetalle.setInt(4, p.getCantidad());
                    psDetalle.setDouble(5, p.getPrecioUnitario());
                    psDetalle.setDouble(6, p.getCantidad() * p.getPrecioUnitario());
                    psDetalle.executeUpdate();
                }
            }

            conn.commit();
        } catch (SQLException e) {
            conn.rollback();
            System.err.println(&quot;Error comprarBoletos (rollback): &quot; + e.getMessage());
            return null;
        }
    } catch (SQLException e) {
        System.err.println(&quot;Error comprarBoletos: &quot; + e.getMessage());
        return null;
    }
    return factura;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o272">
<a:ObjectID>21F790BA-2C70-4D33-8FC3-BA1CB0190248</a:ObjectID>
